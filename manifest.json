{
  "manifest_version": 3,
  "name": "RVU Wi-Fi Auto Login",
  "version": "1.0.0",
  "description": "Seamlessly authenticate to the RVU campus Wi-Fi captive portal with your saved USN and password.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RVU Wi-Fi Auto Login",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://10.16.0.1/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://10.16.0.1/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content/page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://10.16.0.1/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ]
}
